{
  "@context": {
    "@version": "1.1",
    "@import": "http://www.w3.org/ns/anno.jsonld",
    "@protected": true,
    "language": "@language",
    "direction": "@direction",
    "id": "@id",
    "type": "@type",
    "value": "@value",
    "About": "https://www.w3.org/ns/epub/annotation/vocabulary#About",
    "Annotation": {
      "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#Annotation",
      "@context": {
        "@protected": true,
        "body": {
          "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#hasBody",
          "@type": "@id"
        },
        "motivation": {
          "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#motivatedBy",
          "@type": "@vocab",
          "@context": {
            "bookmarking": "http://www.w3.org/ns/oa#bookmarking",
            "commenting": "http://www.w3.org/ns/oa#commenting",
            "highlighting": "http://www.w3.org/ns/oa#highlighting",
            "@vocab": "ea:INVALID_VALUE:"
          }
        },
        "target": {
          "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#hasTarget",
          "@type": "@id"
        }
      }
    },
    "AnnotationSet": {
      "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#AnnotationSet",
      "@context": {
        "@protected": true,
        "about": {
          "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#about",
          "@type": "@id"
        },
        "generator": {
          "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#generator",
          "@type": "@id"
        },
        "items": {
          "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#items",
          "@type": "@id",
          "@container": "@set"
        },
        "title": {
          "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#hasTitle",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      }
    },
    "Body": {
      "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#Body",
      "@context": {
        "@protected": true,
        "color": {
          "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#color",
          "@type": "@vocab",
          "@context": {
            "pink": "https://www.w3.org/ns/epub/annotation/vocabulary#pink",
            "orange": "https://www.w3.org/ns/epub/annotation/vocabulary#orange",
            "yellow": "https://www.w3.org/ns/epub/annotation/vocabulary#yellow",
            "green": "https://www.w3.org/ns/epub/annotation/vocabulary#green",
            "blue": "https://www.w3.org/ns/epub/annotation/vocabulary#blue",
            "purple": "https://www.w3.org/ns/epub/annotation/vocabulary#purple",
            "@vocab": "ea:INVALID_VALUE:"
          }
        },
        "highlight": {
          "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#highlight",
          "@type": "@vocab",
          "@context": {
            "solid": "https://www.w3.org/ns/epub/annotation/vocabulary#solid",
            "underline": "https://www.w3.org/ns/epub/annotation/vocabulary#underline",
            "strikethrough": "https://www.w3.org/ns/epub/annotation/vocabulary#strikethrough",
            "outline": "https://www.w3.org/ns/epub/annotation/vocabulary#outline",
            "@vocab": "ea:INVALID_VALUE:"
          }
        },
        "tags": {
          "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#tags",
          "@type": "http://www.w3.org/2001/XMLSchema#string",
          "@container": "@set"
        }
      }
    },
    "Creator": {
      "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#Creator",
      "@context": {
        "@protected": true,
        "name": {
          "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#name",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      }
    },
    "Meta": "https://www.w3.org/ns/epub/annotation/vocabulary#Meta",
    "Generator": {
      "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#Generator",
      "@context": {
        "@protected": true,
        "name": {
          "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#name",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        }
      }
    },
    "Selector": "https://www.w3.org/ns/epub/annotation/vocabulary#Selector",
    "Target": {
      "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#Target",
      "@context": {
        "@protected": true,
        "meta": {
          "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#meta",
          "@type": "@id"
        },
        "source": {
          "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#hasSource",
          "@type": "@id"
        }
      }
    },
    "creator": {
      "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#creator",
      "@type": "@id"
    },
    "homepage": "http://xmlns.com/foaf/0.1/homepage",
    "selector": {
      "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#hasSelector",
      "@type": "@id"
    },
    "pink": "https://www.w3.org/ns/epub/annotation/vocabulary#pink",
    "orange": "https://www.w3.org/ns/epub/annotation/vocabulary#orange",
    "yellow": "https://www.w3.org/ns/epub/annotation/vocabulary#yellow",
    "green": "https://www.w3.org/ns/epub/annotation/vocabulary#green",
    "blue": "https://www.w3.org/ns/epub/annotation/vocabulary#blue",
    "purple": "https://www.w3.org/ns/epub/annotation/vocabulary#purple",
    "solid": "https://www.w3.org/ns/epub/annotation/vocabulary#solid",
    "underline": "https://www.w3.org/ns/epub/annotation/vocabulary#underline",
    "strikethrough": "https://www.w3.org/ns/epub/annotation/vocabulary#strikethrough",
    "outline": "https://www.w3.org/ns/epub/annotation/vocabulary#outline"
  }
}
