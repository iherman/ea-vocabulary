    "rdfs:range": "xsd:string",
    "rdfs:label": "Title of the Annotation Set",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
