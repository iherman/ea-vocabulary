    "rdfs:subPropertyOf": ["oa:hasSource"],
    "rdfs:domain": "ea:Target",
    "rdfs:range": [],
    "rdfs:label": "Source",
    "rdfs:comment": {
      "@value": "<div>The context file \"shadows\" the <code>source</code> term in the Web Annotation context file, restricting its domain and controlling its alias name.</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target",
    "vs:term_status": "stable",
    "mentioned": [{
