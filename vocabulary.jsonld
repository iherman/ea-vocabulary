    "@type": ["rdf:Property", "owl:DatatypeProperty"],
    "rdfs:domain": "ea:Body",
    "rdfs:range": "xsd:string",
    "rdfs:label": "Keyword",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-4-body",
