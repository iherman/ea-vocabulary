{
  "@context": {
    "ea": "https://www.w3.org/ns/epub/annotation/vocabulary#",
    "oa": "http://www.w3.org/ns/oa#",
    "as": "http://www.w3.org/ns/activitystreams#",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "dc": "http://purl.org/dc/terms/",
    "dcterms": "http://purl.org/dc/terms/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "vs": "http://www.w3.org/2003/06/sw-vocab-status/ns#",
    "jsonld": "http://www.w3.org/ns/json-ld#",
    "dc:date": {
      "@type": "xsd:date"
    },
    "rdfs:domain": {
      "@type": "@id"
    },
    "rdfs:range": {
      "@type": "@id"
    },
    "rdfs:seeAlso": {
      "@type": "@id"
    },
    "rdfs:subClassOf": {
      "@type": "@id"
    },
    "rdfs:subPropertyOf": {
      "@type": "@id"
    },
    "rdfs:isDefinedBy": {
      "@type": "@id"
    },
    "owl:oneOf": {
      "@container": "@list",
      "@type": "@vocab"
    },
    "owl:deprecated": {
      "@type": "xsd:boolean"
    },
    "owl:inverseOf": {
      "@type": "@vocab"
    },
    "owl:unionOf": {
      "@container": "@list",
      "@type": "@vocab"
    },
    "rdfs_classes": {
      "@reverse": "rdfs:isDefinedBy",
      "@type": "@id"
    },
    "rdfs_properties": {
      "@reverse": "rdfs:isDefinedBy",
      "@type": "@id"
    },
    "rdfs_individuals": {
      "@reverse": "rdfs:isDefinedBy",
      "@type": "@id"
    },
    "rdfs_datatypes": {
      "@reverse": "rdfs:isDefinedBy",
      "@type": "@id"
    },
    "mentioned": {
      "@reverse": "schema:mentions",
      "@type": "@id"
    }
  },
  "@id": "https://www.w3.org/ns/epub/annotation/vocabulary#",
  "@type": "owl:Ontology",
  "dc:title": {
    "@value": "EPUB Annotations vocabulary",
    "@language": "en"
  },
  "dc:description": {
    "@value": "RDFS [[RDF-SCHEMA]] vocabulary used by the EPUB Annotation, as a profile of the W3C Web Annotation vocabulary.",
    "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
  },
  "rdfs:seeAlso": "https://w3c.github.io/epub-specs/epub34/annotations/",
  "dc:date": "2026-01-07",
  "rdfs_properties": [{
    "@id": "ea:about",
    "@type": ["rdf:Property", "owl:ObjectProperty"],
    "rdfs:domain": "ea:AnnotationSet",
    "rdfs:range": "ea:About",
    "rdfs:label": "Information on the publication",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:hasBody",
    "@type": ["rdf:Property", "owl:ObjectProperty"],
    "rdfs:subPropertyOf": ["oa:hasBody"],
    "rdfs:domain": "ea:Annotation",
    "rdfs:range": "ea:Body",
    "rdfs:label": "The body of an annotation",
    "rdfs:comment": {
      "@value": "<div>The context file \"shadows\" the <code>body</code> term in the Web Annotation context file, restricting its range.</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-4-body",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:color",
    "@type": "rdf:Property",
    "rdfs:domain": "ea:Body",
    "rdfs:range": {
      "@type": "owl:class",
      "owl:oneOf": ["ea:pink", "ea:orange", "ea:yellow", "ea:green", "ea:blue", "ea:purple"]
    },
    "rdfs:label": "Color",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-4-body",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:creator",
    "@type": ["rdf:Property", "owl:ObjectProperty"],
    "rdfs:subPropertyOf": ["dcterms:creator"],
    "rdfs:range": "ea:Creator",
    "rdfs:label": "The creator of an annotation",
    "rdfs:comment": {
      "@value": "<div>The usage of the Dublin Core's <code>dcterm</code> value is restricted to certain type of values...</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-1-annotation-object",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:generator",
    "@type": ["rdf:Property", "owl:ObjectProperty"],
    "rdfs:domain": "ea:AnnotationSet",
    "rdfs:range": "ea:Generator",
    "rdfs:label": "Generator",
    "rdfs:comment": {
      "@value": "<div>The context file \"shadows\" the <code>generator</code> term in the Web Annotation context file, restricting its range; see formal definition for the restrictions.</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:highlight",
    "@type": "rdf:Property",
    "rdfs:domain": "ea:Body",
    "rdfs:range": {
      "@type": "owl:class",
      "owl:oneOf": ["ea:solid", "ea:underline", "ea:strikethrough", "ea:outline"]
    },
    "rdfs:label": "Highlight",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-4-body",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:items",
    "@type": ["rdf:Property", "owl:ObjectProperty"],
    "rdfs:domain": "ea:AnnotationSet",
    "rdfs:range": "ea:Annotation",
    "rdfs:label": "The reference to the set of annotations",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:meta",
    "@type": ["rdf:Property", "owl:ObjectProperty"],
    "rdfs:domain": "ea:Target",
    "rdfs:range": "ea:Meta",
    "rdfs:label": "Meta",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:motivatedBy",
    "@type": "rdf:Property",
    "rdfs:subPropertyOf": ["oa:motivatedBy"],
    "rdfs:domain": "ea:Annotation",
    "rdfs:range": ["ea:Motivation", {
      "@type": "owl:class",
      "owl:oneOf": ["oa:bookmarking", "oa:commenting", "oa:highlighting"]
    }],
    "rdfs:label": "The motivation for an annotation",
    "rdfs:comment": {
      "@value": "<div>The context file \"shadows\" the <code>body</code> term in the Web Annotation context file, restricting its range.</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-1-annotation-object",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:name",
    "@type": ["rdf:Property", "owl:DatatypeProperty"],
    "rdfs:subPropertyOf": ["foaf:name"],
    "rdfs:domain": {
      "@type": "owl:Class",
      "owl:unionOf": ["ea:Creator", "ea:Generator"]
    },
    "rdfs:range": "xsd:string",
    "rdfs:label": "Name",
    "rdfs:comment": {
      "@value": "<div>This property restricts the usage of <code>foaf:name</code> to be used on creators.</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:hasSelector",
    "@type": ["rdf:Property", "owl:ObjectProperty"],
    "rdfs:subPropertyOf": ["oa:hasSelector"],
    "rdfs:range": "ea:Selector",
    "rdfs:label": "Assign selector(s) to a target",
    "rdfs:comment": {
      "@value": "<div>The range of this subproperty represents a subset of the Selectors, as defined by the Open Annotation specification.</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:hasSource",
    "@type": ["rdf:Property", "owl:ObjectProperty"],
    "rdfs:subPropertyOf": ["oa:hasSource"],
    "rdfs:domain": "ea:Target",
    "rdfs:label": "Has source",
    "rdfs:comment": {
      "@value": "<div>The context file \"shadows\" the <code>source</code> term in the Web Annotation context file, restricting its domain and controlling its alias name.</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:tags",
    "@type": ["rdf:Property", "owl:DatatypeProperty"],
    "rdfs:domain": "ea:Body",
    "rdfs:range": "xsd:string",
    "rdfs:label": "Tags",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-4-body",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:hasTarget",
    "@type": ["rdf:Property", "owl:ObjectProperty"],
    "rdfs:subPropertyOf": ["oa:hasTarget"],
    "rdfs:domain": "ea:Annotation",
    "rdfs:range": "ea:Target",
    "rdfs:label": "The target of an annotation",
    "rdfs:comment": {
      "@value": "<div>The context file \"shadows\" the <code>target</code> term in the Web Annotation context file, restricting its range.</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:hasTitle",
    "@type": ["rdf:Property", "owl:DatatypeProperty"],
    "rdfs:domain": "ea:AnnotationSet",
    "rdfs:range": "xsd:string",
    "rdfs:label": "Title of the Annotation Set",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }],
  "rdfs_classes": [{
    "@id": "ea:About",
    "@type": "rdfs:Class",
    "rdfs:label": "Information about the publication",
    "rdfs:comment": {
      "@value": "<div>The (externally defined) Dublin Core terms are used with this class, retaining the prefixes (to be in line with the EPUB Package Document)</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-2-about",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:Annotation",
    "@type": "rdfs:Class",
    "rdfs:subClassOf": ["oa:Annotation"],
    "rdfs:label": "EPUB Annotation Object",
    "rdfs:comment": {
      "@value": "<div>The Annotation object of EPUB Annotation; the list of acceptable properties are restricted compared to the Web Annotation version.</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-1-annotation-object",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:AnnotationSet",
    "@type": "rdfs:Class",
    "rdfs:label": "Set of annotations",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:Body",
    "@type": "rdfs:Class",
    "rdfs:subClassOf": ["oa:TextualBody"],
    "rdfs:label": "Body of an Annotation",
    "rdfs:comment": {
      "@value": "<div>In EPUB,  annotations are restricted to textual content.</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-4-body",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:Creator",
    "@type": "rdfs:Class",
    "rdfs:subClassOf": {
      "@type": "owl:Class",
      "owl:unionOf": ["foaf:Person", "foaf:Organization", "as:Application"]
    },
    "rdfs:label": "Creator of an Annotation",
    "rdfs:comment": {
      "@value": "<div>The context file contains aliases for the possible creator values, JSON-LD serializations can simply use the terms <code>Person</code>, <code>Organization</code>, or <code>Software</code>.</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-2-creator",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:Meta",
    "@type": "rdfs:Class",
    "rdfs:label": "Meta",
    "rdfs:comment": {
      "@value": "<div>this class is currently undefined...</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:Generator",
    "@type": "rdfs:Class",
    "rdfs:label": "Information about the tools generating the annotations",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-1-generator",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:Selector",
    "@type": "rdfs:Class",
    "rdfs:subClassOf": {
      "@type": "owl:Class",
      "owl:unionOf": ["oa:FragmentSelector", "oa:CssSelector", "oa:TextQuoteSelector"]
    },
    "rdfs:label": "A restrictive subset of selectors, used in EPUB",
    "rdfs:comment": {
      "@value": "<div>The final list of selectors for EPUB is still to be defined, this is only a placeholder for now.</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:Target",
    "@type": "rdfs:Class",
    "rdfs:label": "Target of an Annotation",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }],
  "rdfs_individuals": [{
    "@id": "ea:pink",
    "@type": "rdfs:Resource",
    "rdfs:label": "Pink color for selection color",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:orange",
    "@type": "rdfs:Resource",
    "rdfs:label": "Orange color for selection color",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:yellow",
    "@type": "rdfs:Resource",
    "rdfs:label": "Yellow color for selection color",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:green",
    "@type": "rdfs:Resource",
    "rdfs:label": "Green color for selection color",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:blue",
    "@type": "rdfs:Resource",
    "rdfs:label": "Blue color for selection color",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:purple",
    "@type": "rdfs:Resource",
    "rdfs:label": "Purple color for selection color",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:solid",
    "@type": "rdfs:Resource",
    "rdfs:label": "Selection highlight solid",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:underline",
    "@type": "rdfs:Resource",
    "rdfs:label": "Selection highlight underline",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:strikethrough",
    "@type": "rdfs:Resource",
    "rdfs:label": "Selection highlight strikethrough",
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://www.w3.org/ns/epub/anno.jsonld",
      "@type": "jsonld:Context"
    }]
  }, {
    "@id": "ea:outline",
