    "rdfs:subPropertyOf": ["oa:motivatedBy"],
    "rdfs:domain": "ea:Annotation",
    "rdfs:range": "oa:Motivation",
    "rdfs:label": "The motivation for an annotation",
    "rdfs:comment": {
      "@value": "<div>The context file \"shadows\" the <code>body</code> term in the Web Annotation context file, restricting its range; see formal definition for the restrictions.</div>",
      "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"
    },
    "rdfs:isDefinedBy": "https://w3c.github.io/epub-specs/epub34/annotations/#1-1-annotation-object",
    "vs:term_status": "stable",
    "mentioned": [{
      "@id": "https://wwww.w3.org/ns/epub/annotation/context",
      "@type": "jsonld:Context"
    }]
  }, {
