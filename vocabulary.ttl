@prefix ea: <https://www.w3.org/ns/epub/annotation/vocabulary#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix as: <http://www.w3.org/ns/activitystreams#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

# Ontology definition
ea: a owl:Ontology ;
    dc:title """EPUB Annotations vocabulary"""@en ;
    dc:description """RDFS [[RDF-SCHEMA]] vocabulary used by the EPUB Annotation, as a profile of the W3C Web Annotation vocabulary."""^^rdf:HTML ;
    rdfs:seeAlso <https://w3c.github.io/epub-specs/epub34/annotations/> ;
    dc:date "2026-01-06"^^xsd:date ;
.

# Property definitions
ea:about a rdf:Property, owl:ObjectProperty ;
    rdfs:domain ea:AnnotationSet ;
    rdfs:range ea:About ;
    rdfs:label "Information on the publication" ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:hasBody a rdf:Property, owl:ObjectProperty ;
    rdfs:subPropertyOf oa:hasBody ;
    rdfs:domain ea:Annotation ;
    rdfs:range ea:Body ;
    rdfs:label "The body of an annotation" ;
    rdfs:comment """<div>The context file "shadows" the <code>body</code> term in the Web Annotation context file, restricting its range.</div>"""^^rdf:HTML ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-4-body>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:color a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain ea:Body ;
    rdfs:range ea:Color ;
    rdfs:label "Color" ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-4-body>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:creator a rdf:Property, owl:ObjectProperty ;
    rdfs:subPropertyOf dcterms:creator ;
    rdfs:range ea:Creator ;
    rdfs:label "The creator of an annotation" ;
    rdfs:comment """<div>The usage of the Dublin Core's <code>dcterm</code> value is restricted to certain type of values...</div>"""^^rdf:HTML ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-1-annotation-object>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:generator a rdf:Property, owl:ObjectProperty ;
    rdfs:domain ea:AnnotationSet ;
    rdfs:range ea:Generator ;
    rdfs:label "Generator" ;
    rdfs:comment """<div>The context file "shadows" the <code>generator</code> term in the Web Annotation context file, restricting its range; see formal definition for the restrictions.</div>"""^^rdf:HTML ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:highlight a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain ea:Body ;
    rdfs:range ea:Highlight ;
    rdfs:label "Highlight" ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-4-body>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:items a rdf:Property, owl:ObjectProperty ;
    rdfs:domain ea:AnnotationSet ;
    rdfs:range ea:Annotation ;
    rdfs:label "The reference to the set of annotations" ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:meta a rdf:Property, owl:ObjectProperty ;
    rdfs:domain ea:Target ;
    rdfs:range ea:Meta ;
    rdfs:label "Meta" ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:motivatedBy a rdf:Property, owl:ObjectProperty ;
    rdfs:subPropertyOf oa:motivatedBy ;
    rdfs:domain ea:Annotation ;
    rdfs:range ea:Motivation ;
    rdfs:label "The motivation for an annotation" ;
    rdfs:comment """<div>The context file "shadows" the <code>body</code> term in the Web Annotation context file, restricting its range.</div>"""^^rdf:HTML ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-1-annotation-object>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:name a rdf:Property, owl:DatatypeProperty ;
    rdfs:subPropertyOf foaf:name ;
    rdfs:domain [ a owl:Class; owl:unionOf (ea:Creator ea:Generator) ] ;
    rdfs:range xsd:string ;
    rdfs:label "Name" ;
    rdfs:comment """<div>This property restricts the usage of <code>foaf:name</code> to be used on creators.</div>"""^^rdf:HTML ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:hasSelector a rdf:Property, owl:ObjectProperty ;
    rdfs:subPropertyOf oa:hasSelector ;
    rdfs:range ea:Selector ;
    rdfs:label "Assign selector(s) to a target" ;
    rdfs:comment """<div>The range of this subproperty represents a subset of the Selectors, as defined by the Open Annotation specification.</div>"""^^rdf:HTML ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:hasSource a rdf:Property, owl:ObjectProperty ;
    rdfs:subPropertyOf oa:hasSource ;
    rdfs:domain ea:Target ;
    rdfs:label "Has source" ;
    rdfs:comment """<div>The context file "shadows" the <code>source</code> term in the Web Annotation context file, restricting its domain and controlling its alias name.</div>"""^^rdf:HTML ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:tags a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain ea:Body ;
    rdfs:range xsd:string ;
    rdfs:label "Tags" ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-4-body>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:hasTarget a rdf:Property, owl:ObjectProperty ;
    rdfs:subPropertyOf oa:hasTarget ;
    rdfs:domain ea:Annotation ;
    rdfs:range ea:Target ;
    rdfs:label "The target of an annotation" ;
    rdfs:comment """<div>The context file "shadows" the <code>target</code> term in the Web Annotation context file, restricting its range.</div>"""^^rdf:HTML ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:hasTitle a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain ea:AnnotationSet ;
    rdfs:range xsd:string ;
    rdfs:label "Title of the Annotation Set" ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

# Class definitions
ea:About a rdfs:Class ;
    rdfs:label "Information about the publication" ;
    rdfs:comment """<div>The (externally defined) Dublin Core terms are used with this class, retaining the prefixes (to be in line with the EPUB Package Document)</div>"""^^rdf:HTML ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#2-2-about>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:Annotation a rdfs:Class ;
    rdfs:subClassOf oa:Annotation ;
    rdfs:label "EPUB Annotation Object" ;
    rdfs:comment """<div>The Annotation object of EPUB Annotation; the list of acceptable properties are restricted compared to the Web Annotation version.</div>"""^^rdf:HTML ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-1-annotation-object>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:AnnotationSet a rdfs:Class ;
    rdfs:label "Set of annotations" ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:Body a rdfs:Class ;
    rdfs:subClassOf oa:TextualBody ;
    rdfs:label "Body of an Annotation" ;
    rdfs:comment """<div>In EPUB,  annotations are restricted to textual content.</div>"""^^rdf:HTML ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-4-body>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:Creator a rdfs:Class ;
    rdfs:subClassOf [ a owl:Class; owl:unionOf (foaf:Person foaf:Organization as:Application) ] ;
    rdfs:label "Creator of an Annotation" ;
    rdfs:comment """<div>The context file contains aliases for the possible creator values, JSON-LD serializations can simply use the terms <code>Person</code>, <code>Organization</code>, or <code>Software</code>.</div>"""^^rdf:HTML ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-2-creator>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:Meta a rdfs:Class ;
    rdfs:label "Meta" ;
    rdfs:comment """<div>this class is currently undefined...</div>"""^^rdf:HTML ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:Generator a rdfs:Class ;
    rdfs:label "Information about the tools generating the annotations" ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#2-1-generator>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:Motivation a rdfs:Class, owl:Class ;
    rdfs:subClassOf oa:Motivation ;
    owl:oneOf (oa:bookmarking oa:commenting oa:highlighting) ;
    rdfs:label "A restrictive subset of Open Annotation's Motivations" ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-1-annotation-object>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:Selector a rdfs:Class ;
    rdfs:subClassOf [ a owl:Class; owl:unionOf (oa:FragmentSelector oa:CssSelector oa:TextQuoteSelector) ] ;
    rdfs:label "A restrictive subset of selectors, used in EPUB" ;
    rdfs:comment """<div>The final list of selectors for EPUB is still to be defined, this is only a placeholder for now.</div>"""^^rdf:HTML ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:Target a rdfs:Class ;
    rdfs:label "Target of an Annotation" ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#1-3-target>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.



# Definitions of datatypes
ea:Color a rdfs:Datatype ;
    rdfs:subClassOf xsd:string ;
    owl:onDatatype xsd:string ;
    owl:withRestrictions ([xsd:pattern "pink|orange|yellow|green|blue|purple"]) ;
    rdfs:label "Color" ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

ea:Highlight a rdfs:Datatype ;
    rdfs:subClassOf xsd:string ;
    owl:onDatatype xsd:string ;
    owl:withRestrictions ([xsd:pattern "solid|underline|strikethrough|outline"]) ;
    rdfs:label "Highlight" ;
    rdfs:isDefinedBy <https://w3c.github.io/epub-specs/epub34/annotations/#2-annotation-set>, <https://www.w3.org/ns/epub/annotation/vocabulary#> ;
    vs:term_status "stable" ;
.

# Context files and their mentions
<https://www.w3.org/ns/epub/anno.jsonld> a jsonld:Context ;
    schema:mentions
        ea:About,
        ea:Annotation,
        ea:AnnotationSet,
        ea:Body,
        ea:Color,
        ea:Creator,
        ea:Generator,
        ea:Highlight,
        ea:Meta,
        ea:Motivation,
        ea:Selector,
        ea:Target,
        ea:about,
        ea:color,
        ea:creator,
        ea:generator,
        ea:hasBody,
        ea:hasSelector,
        ea:hasSource,
        ea:hasTarget,
        ea:hasTitle,
        ea:highlight,
        ea:items,
        ea:meta,
        ea:motivatedBy,
        ea:name,
        ea:tags,
        foaf:homepage ;
.

